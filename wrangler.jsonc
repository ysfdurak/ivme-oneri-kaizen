// İvme · Cloudflare Workers yayın ayarları (ivme.ysfdurak.com canlı demosu).
// Şirket kurulumunda: IVME_VITRIN "0" yapılır (ya da satır silinir), "name" ve veritabanı adı değiştirilir,
// e-posta için EMAIL_PROVIDER ve ilgili gizli anahtarlar Cloudflare panelinden eklenir (docs/MCP_REHBERI.md, README).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ivme",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  // Kimliksiz D1 bağlaması: ilk "wrangler deploy" veritabanını kendisi oluşturur (otomatik kaynak oluşturma).
  // Tablolar uygulamanın ilk açılışında kurulur (lib/server.ts → ensureBaseSchema).
  "d1_databases": [{ "binding": "DB", "database_name": "ivme-db" }],
  "vars": {
    // 1 = herkese açık vitrin demosu: rolle şifresiz giriş, örnek veri, her gece sıfırlama.
    "IVME_VITRIN": "1",
    // ai = MCP katmanlı sürüm (yapay zekâ bağlantısı Tanımlar'dan açılır, varsayılan kapalı); surec = yalnız süreç.
    "IVME_EDITION": "ai",
    // log = e-posta gönderilmez.
    "EMAIL_PROVIDER": "log",
    // Arayüzün varsayılan dili ve vitrin verisinin dili: tr | en. Kişi arayüz dilini TR/EN düğmesiyle değiştirebilir.
    "IVME_LANG": "tr",
    // Vitrinde giriş ekranında öteki dildeki demoya bağlantı (boşsa gösterilmez).
    "IVME_ALT_DEMO_URL": "https://ivme-en.ysfdurak.com",
    // Vitrin demosunun kendi adresi: arama ve paylaşım etiketleri (canonical, hreflang, Open Graph) için. Şirket kurulumunda boş bırakılır.
    "IVME_PUBLIC_URL": "https://ivme.ysfdurak.com"
  },
  // Her gece 00:00 UTC (03:00 TR): vitrin verisini sıfırla (worker/index.ts → scheduled).
  "triggers": { "crons": ["0 0 * * *"] },
  "observability": { "enabled": true },
  // İngilizce canlı demo (ivme-en.ysfdurak.com): aynı kod, ayrı Worker ve ayrı veritabanı, İngilizce örnek veri.
  // Derleme: CLOUDFLARE_ENV=en npm run build → npx wrangler deploy (README → Yayın).
  "env": {
    "en": {
      "name": "ivme-en",
      "d1_databases": [{ "binding": "DB", "database_name": "ivme-en-db" }],
      "vars": {
        "IVME_VITRIN": "1",
        "IVME_EDITION": "ai",
        "EMAIL_PROVIDER": "log",
        "IVME_LANG": "en",
        "IVME_ALT_DEMO_URL": "https://ivme.ysfdurak.com",
        "IVME_PUBLIC_URL": "https://ivme-en.ysfdurak.com"
      },
      "triggers": { "crons": ["0 0 * * *"] }
    }
  }
}
